{
  "compilerOptions": {
    "allowJs": true,
    "types": [
      "node",
      "@cloudflare/workers-types",
      "vinext/types"
    ],
    "incremental": true,
    "paths": {
      "@/*": [
        "./*"
      ]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "**/*.mts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    ".private",
    "work"
  ],
  "extends": "../config/tsconfig.json"
}
