{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  // Deploy with CLOUDFLARE_ACCOUNT_ID set to the Automation Cloud account;
  // see README.md.
  "name": "ubio-halls",
  "main": "server/index.ts",
  "compatibility_date": "2026-05-22",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ubio-halls",
      "database_id": "e61f3cac-d212-4b02-82d8-508e2fc9213c",
      "migrations_dir": "db/migrations"
    }
  ],
  "observability": { "enabled": true },
  "workers_dev": false,
  "routes": [{ "pattern": "halls.ubio.dev", "custom_domain": true }],
  "vars": {
    "APP_ORIGIN": "https://halls.ubio.dev",
    // The A3 project and dataset Halls reads, and the workflow that prepares a
    // booking. The service-account key is the HALLS_A3_TOKEN secret.
    "HALLS_A3_PROJECT": "ubio/student-accommodation-iq",
    "HALLS_A3_DATASET": "",
    "HALLS_A3_BOOKING_WORKFLOW": "",
    // Comma-separated addresses that administer Halls.
    "HALLS_ADMINS": ""
  }
}
