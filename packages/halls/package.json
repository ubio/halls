    "@vitejs/plugin-rsc": "0.5.34",
    "oxfmt": "0.61.0",
    "oxlint": "1.76.0",
    "pkce-challenge": "5.0.1",
    "tailwindcss": "4.2.1",
    "tsx": "^4.23.13",
